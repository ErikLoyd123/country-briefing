# Copy this file to .env and fill in the values. .env is gitignored — never commit real keys.
# These are used only by local scripts that download photos/videos into the repo.
# They are never bundled into the website.

# Unsplash: cinematic photos (skylines, streets, markets)
# 1. Sign in at https://unsplash.com/developers
# 2. "Your apps" → "New Application" → accept the API guidelines → name it (e.g. "country-briefing")
# 3. Copy the "Access Key" (not the Secret Key). Demo mode (50 requests/hour) is enough.
UNSPLASH_ACCESS_KEY=

# Pexels: short video loops (Saigon traffic, monsoon rain, port cranes) and extra photos
# 1. Sign in at https://www.pexels.com/api/
# 2. Click "Your API Key" / request a key (issued instantly)
# 3. Copy the key
PEXELS_API_KEY=

# Wikimedia Commons: real landmarks (Parliament House, National Assembly, ports). No key needed.
# Wikimedia asks automated requests to identify themselves with a contact address.
MEDIA_CONTACT_EMAIL=
