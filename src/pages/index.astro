---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/story/HeroMedia.astro';
import HeroReel from '../components/story/HeroReel.astro';
import RiskLevel from '../components/story/RiskLevel.astro';
import RegionMap from '../components/maps/RegionMap.astro';
import AnimatedNumber from '../components/ui/AnimatedNumber.jsx';
import headlineRaw from '../data/headline-numbers.yaml?raw';
import { loadYaml } from '../lib/yaml.js';
import { getTopics } from '../lib/topics.js';
import { getRisks } from '../lib/risks.js';
import { citationHtml, withCitation } from '../lib/sources.js';
import { AREAS, COUNTRY, RISK_LEVELS } from '../lib/format.js';
import { ArrowRight, FileText, BookOpen } from '@lucide/astro';

const topics = await getTopics();
const bySlug = Object.fromEntries(topics.map((t) => [t.slug, t]));
const link = (slug) => ({ href: `/briefing/${slug}`, label: bySlug[slug]?.short ?? slug });

const headline = loadYaml(headlineRaw, 'src/data/headline-numbers.yaml');
// Pure numbers count up; ratings like "A2" or "BB+" are shown as written.
const animated = (value) => {
  const m = /^(US\$|S\$|\$)?([\d,]+(?:\.\d+)?)(%?)$/.exec(String(value));
  return m ? { prefix: m[1] ?? '', value: Number(m[2].replace(/,/g, '')), suffix: m[3], decimals: 0 } : null;
};

const risks = getRisks();
const riskAreas = Object.entries(AREAS).map(([id, label]) => ({
  id,
  label,
  SG: risks.filter((r) => r.area === id && r.country === 'SG'),
  VN: risks.filter((r) => r.area === id && r.country === 'VN'),
}));
const dangers = topics.find((t) => t.slug === 'dangers-annoyances');

const trade = [
  { label: 'Free trade agreements in force', SG: ['29', ['SG-68']], VN: ['18', ['VN-63']] },
  { label: 'World Bank logistics index', SG: ['1st, scoring 4.3', ['SG-12']], VN: ['43rd, scoring 3.3', ['VN-62']] },
  { label: 'Main trade partners', SG: ['Taiwan, China, Malaysia and the US', ['SG-69']], VN: ['The US is the top export market; China supplies 40% of imports', ['VN-45', 'VN-46']] },
];
const tradeText = [
  ["Singapore's value is as a neutral hub between the US and China.", []],
  ['China has been its largest trading partner since 2013, and the US is its largest investor and defence partner.', ['SG-70', 'SG-71']],
  ["Vietnam is where the \"China plus one\" strategy runs: the US is its biggest export market at US$153 billion, and China supplies 40 percent of its imports.", ['VN-45', 'VN-46']],
];

const questions = [
  {
    q: 'What are the perceived risks of doing business in Singapore and Vietnam in the areas of government, society (health, education), security (emergencies, disasters, crime), and economy?',
    links: ['dangers-annoyances', 'need-to-know', 'local-knowledge'],
  },
  { q: 'What does this mean for foreign direct investment?', links: ['money-matters', 'local-knowledge'] },
  {
    q: "How might the country's current political environment affect business? Consider transparency, corruption, trading partners and trade agreements, civil unrest, and the industries most impacted.",
    links: ['political-weather', 'itineraries'],
  },
];
---

<BaseLayout title="Overview">
  <!-- Hero: synced Singapore / Vietnam aerial reel. Its center seam continues down the page below. -->
  <section data-hero class="relative isolate grid min-h-[calc(100svh-3.5rem)] grid-rows-[1fr_auto] overflow-hidden bg-night text-on-night">
    <HeroReel
      pairs={[
        { sg: { video: 'video/reel/sg-marina-bay-aerial.mp4', place: 'Marina Bay' }, vn: { video: 'video/reel/vn-limestone-mountains-aerial.mp4', place: 'Limestone mountains' } },
        { sg: { video: 'video/reel/sg-gardens-by-the-bay-aerial.mp4', place: 'Gardens by the Bay' }, vn: { video: 'video/reel/vn-ha-long-bay-aerial.mp4', place: 'Ha Long Bay' } },
        { sg: { video: 'video/reel/sg-skyline-dusk-aerial.mp4', place: 'Downtown Core at dusk' }, vn: { video: 'video/reel/vn-mountain-landscape-aerial.mp4', place: 'Mountain landscape' } },
      ]}
    />

    <div data-hero-line class="container-wide relative grid gap-6 border-t border-white/10 py-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h1 class="type-heavy max-w-3xl text-3xl leading-[1.05] tracking-[-0.035em] md:text-4xl">
          Politics and Risk Desk<span class="sr-only">: Singapore and Vietnam</span>
        </h1>
        <p class="mt-3 max-w-2xl text-on-night-muted">What to know before you land, what can go wrong, what it means for your money, and what to ask when you are standing in the room.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="#question" class="inline-flex items-center gap-2 rounded-full bg-saffron px-6 py-3 font-semibold text-ink shadow-lg shadow-black/20 transition hover:brightness-105">
          Start the briefing <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a href="/paper" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-3 font-medium text-white hover:bg-white/10">
          <FileText size={16} aria-hidden="true" /> Paper
        </a>
      </div>
    </div>
  </section>

  <!-- The question, the numbers and the risks share the seam: joined content covers it, comparisons split on it. -->
  <div class="relative">
    <div class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px bg-ink/15 md:block" aria-hidden="true"></div>

    <section id="question" class="scroll-mt-14 px-4 pt-24 pb-20 md:pt-32 md:pb-28">
      <div class="relative mx-auto max-w-4xl bg-paper py-4 text-center">
        <h2 class="mx-auto max-w-[22ch] text-4xl leading-[1.08] text-ink md:text-6xl">What would a company need to know before committing to Singapore or Vietnam?</h2>
        <p class="mx-auto mt-7 max-w-[40rem] font-display text-xl leading-relaxed text-ink-2">
          Doing business in these two countries, told the way a guidebook tells it. Every fact carries a source you can click. Two companies, Crocs and Mastercard, run through
          every section so you can watch the same firm cross the border.
        </p>
      </div>
    </section>

    <section aria-labelledby="numbers-heading" class="pb-24 md:pb-32">
      <div class="container-wide">
        <h2 id="numbers-heading" class="relative mx-auto w-fit bg-paper px-6 py-2 text-center text-2xl text-ink md:text-3xl">Two countries, five numbers</h2>

        <div class="mt-10 grid grid-cols-2 text-sm font-medium text-ink md:mt-14" aria-hidden="true">
          <p class="flex items-center justify-end gap-2 pr-4 md:pr-10"><span class="size-2.5 rounded-full bg-sg"></span>{COUNTRY.SG.name}</p>
          <p class="flex items-center gap-2 pl-4 md:pl-10"><span class="size-2.5 rounded-full bg-vn"></span>{COUNTRY.VN.name}</p>
        </div>

        <dl class="mx-auto mt-6 max-w-5xl space-y-12 md:space-y-14">
          {
            headline.map((row) => (
              <div>
                <dt class="relative mx-auto w-fit bg-paper px-3 text-center">
                  <span class="block text-ink">{row.label}</span>
                  {row.note && <span class="block text-sm text-muted">{row.note}</span>}
                </dt>
                <div class="mt-3 grid grid-cols-2">
                  {['SG', 'VN'].map((c) => {
                    const cell = row[c];
                    const n = animated(cell.value);
                    return (
                      <dd class:list={['min-w-0', c === 'SG' ? 'pr-4 text-right md:pr-10' : 'pl-4 md:pl-10']}>
                        <span class="sr-only">{COUNTRY[c].name}: </span>
                        <span class="type-heavy num block text-[clamp(1.5rem,6.5vw,4.5rem)] leading-none text-ink">
                          {n ? (
                            <>
                              <span class="screen-only"><AnimatedNumber client:visible {...n} /></span>
                              <span class="print-only">{cell.value}</span>
                            </>
                          ) : (
                            cell.value
                          )}
                        </span>
                        <span class="mt-2 block text-sm text-ink-2">
                          {cell.detail} <Fragment set:html={citationHtml(cell.cite, undefined, `headline-numbers.yaml (${row.label})`)} />
                        </span>
                      </dd>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {
      risks.length > 0 && (
        <section aria-labelledby="risks-heading" class="border-t border-rule pt-20 pb-24 md:pt-28 md:pb-32">
          <div class="container-wide">
            <div class="relative mx-auto max-w-2xl bg-paper px-6 py-2 text-center">
              <h2 id="risks-heading" class="text-2xl text-ink md:text-3xl">The risks, as we read them</h2>
              <p class="mt-3 text-ink-2">Every risk in {dangers?.short ?? 'the briefing'}, ranked by how much it should change what you do.</p>
              <ul class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Risk levels">
                {Object.keys(RISK_LEVELS).map((level) => (
                  <li>
                    <RiskLevel level={level} />
                  </li>
                ))}
              </ul>
            </div>

            <div class="mx-auto mt-14 max-w-6xl space-y-14">
              {riskAreas.map((a) => (
                <div>
                  <h3 class="relative mx-auto w-fit bg-paper px-4 text-center font-display text-2xl text-ink">{a.label}</h3>
                  <div class="mt-5 grid gap-y-8 md:grid-cols-2">
                    {['SG', 'VN'].map((c) => (
                      <div class:list={['min-w-0', c === 'SG' ? 'md:pr-10 md:text-right' : 'md:pl-10']}>
                        <p class="mb-3 flex items-center gap-2 text-sm text-muted md:hidden">
                          <span class:list={['size-2 rounded-full', c === 'SG' ? 'bg-sg' : 'bg-vn']} aria-hidden="true" />
                          {COUNTRY[c].name}
                        </p>
                        <span class="sr-only">{COUNTRY[c].name}</span>
                        <ul class="space-y-4">
                          {a[c].map((r) => (
                            <li>
                              <RiskLevel level={r.level} />
                              <a href={r.href} class="mt-1.5 block font-display text-lg leading-snug text-ink underline decoration-transparent underline-offset-4 hover:decoration-ink/40">
                                {r.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>

  <!-- The briefing's sections (pinned + scrubbed on wide screens) -->
  <section data-pin-strip class="overflow-hidden border-t border-rule py-20 lg:flex lg:h-svh lg:flex-col lg:justify-center lg:py-0">
    <div class="container-wide mb-10 flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-4xl text-ink md:text-5xl">{topics.length} sections</h2>
      <p class="max-w-md text-ink-2">Each a short deck of slides, laid out the way the topic compares. Use the arrow keys to move between slides.</p>
    </div>
    <ol data-pin-track class="container-wide grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:mx-0 lg:flex lg:w-max lg:max-w-none lg:gap-10 lg:pr-[20vw] lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]">
      {
        topics.map((t) => (
          <li class="lg:w-[25rem]">
            <a href={`/briefing/${t.slug}`} class="group flex h-full flex-col">
              <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-night">
                <HeroMedia image={t.hero.image} video={t.hero.video} alt={t.hero.alt} label={t.hero.label} sizes="(min-width: 1024px) 25rem, (min-width: 640px) 50vw, 100vw" tone="light" compact />
              </div>
              <p class="num mt-5 text-sm text-muted">Section {t.order}</p>
              <h3 class="mt-1 text-[1.65rem] leading-tight text-ink underline decoration-transparent decoration-1 underline-offset-[5px] group-hover:decoration-ink/40">{t.title}</h3>
              <p class="mt-2 flex-1 text-ink-2">{t.thesis}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Trade: text and figures on the left, the map runs off the right edge. -->
  <section class="overflow-hidden">
    <div class="container-wide grid items-center gap-12 py-20 md:py-28 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 class="max-w-[16ch] text-4xl leading-[1.05] text-ink md:text-5xl">On the main artery of Asian trade</h2>
        <p class="mt-6 font-display text-xl leading-relaxed text-ink-2">
          {tradeText.map(([text, cite]) => <Fragment set:html={withCitation(text, cite, undefined, 'the homepage trade text') + ' '} />)}
        </p>

        <table class="mt-10 w-full text-left">
          <caption class="sr-only">Trade, Singapore and Vietnam</caption>
          <thead>
            <tr class="text-sm text-muted">
              <td></td>
              <th scope="col" class="pb-3 pl-4 font-normal"><span class="mr-1.5 inline-block size-2 rounded-full bg-sg" aria-hidden="true" />Singapore</th>
              <th scope="col" class="pb-3 pl-4 font-normal"><span class="mr-1.5 inline-block size-2 rounded-full bg-vn" aria-hidden="true" />Vietnam</th>
            </tr>
          </thead>
          <tbody>
            {
              trade.map((row) => (
                <tr class="border-t border-rule align-top">
                  <th scope="row" class="w-[28%] py-4 pr-2 text-sm font-normal text-ink">{row.label}</th>
                  {['SG', 'VN'].map((c) => (
                    <td class="py-4 pl-4 text-ink">
                      <span class="block font-semibold tracking-tight">{row[c][0]}</span>
                      <Fragment set:html={citationHtml(row[c][1], undefined, `the homepage trade table (${row.label})`)} />
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>

        <a href="/briefing/political-weather" class="mt-8 inline-block font-medium text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink">Read The Political Weather</a>
      </div>

      <div class="lg:-mr-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]">
        <div class="[&_svg]:rounded-none [&_svg]:rounded-l-md">
          <RegionMap compact />
        </div>
      </div>
    </div>
  </section>

  <!-- The assignment's questions and where each is answered -->
  <section aria-labelledby="questions-heading" class="border-t border-rule">
    <div class="container-wide py-20 md:py-28">
      <h2 id="questions-heading" class="text-4xl text-ink md:text-5xl">The three questions</h2>
      <p class="mt-4 max-w-xl text-ink-2">The assignment asks three things. Here is where each is answered.</p>
      <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-10">
        {
          questions.map((item, i) => (
            <li class="border-t-2 border-ink pt-5">
              <p class="num text-sm text-muted">Question {i + 1}</p>
              <p class="mt-2 font-display text-xl leading-snug text-ink">{item.q}</p>
              <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
                {item.links.map(link).map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex items-center gap-1.5 font-medium text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="mt-20 grid gap-10 md:grid-cols-2">
        {
          [
            { href: '/paper', Icon: FileText, title: 'Read the paper', body: 'Every section in one printable document, with APA citations and the full reference list.' },
            { href: '/sources', Icon: BookOpen, title: 'Check the sources', body: 'All references in APA form, and the verification table the team works from: one row per claim.' },
          ].map(({ href, Icon, title, body }) => (
            <a href={href} class="group block">
              <Icon size={22} class="text-muted" aria-hidden="true" />
              <h3 class="mt-4 text-2xl text-ink underline decoration-transparent decoration-1 underline-offset-[5px] group-hover:decoration-ink/40">{title}</h3>
              <p class="mt-2 max-w-sm text-ink-2">{body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/motion.js';
</script>
