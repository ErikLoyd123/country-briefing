---
// Old link: appendix pages were at /appendix/<slug> before the site had desks. They are Politics & Risk's.
import { getCollection } from 'astro:content';
import { deskPath } from '../../lib/desks.js';

export async function getStaticPaths() {
  return (await getCollection('appendices', (e) => e.id.startsWith('politics-risk/'))).map((e) => ({ params: { slug: e.id.split('/')[1] } }));
}

return Astro.redirect(deskPath('politics-risk', `/appendix/${Astro.params.slug}`), 301);
---
