---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiskLevel from '../components/story/RiskLevel.astro';
import { TEAM } from '../lib/team.js';
---

<BaseLayout title="About" description="Team and risk ratings for the briefing.">
  <div class="container-text py-16">
    <p class="text-sm text-muted">{TEAM.course} · {TEAM.series}</p>
    <h1 class="mt-3 text-5xl">About this briefing</h1>

    <section class="mt-16">
      <h2 class="font-display text-3xl">{TEAM.name}</h2>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
        {TEAM.members.map((name) => <li class="border-b border-rule py-3 text-ink">{name}</li>)}
      </ul>
    </section>

    <section id="risk-levels" class="mt-16 scroll-mt-20">
      <h2 class="font-display text-3xl">How we rate risk</h2>
      <div class="briefing-prose mt-5">
        <p>
          Risks and Constraints covers the perceived risks of doing business in the four areas the assignment names: government, society, security and the economy. Each risk is
          ranked by how much it should change what you do, from highest to lowest. The ranking is the team's judgment, not a score; every fact behind it is cited.
        </p>
      </div>
      <ul class="mt-6 flex flex-wrap gap-3" aria-label="Risk levels, highest first">
        {['high', 'mid', 'low'].map((level) => <li><RiskLevel level={level} /></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
