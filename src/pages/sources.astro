---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadIndex } from '../lib/sources.js';

const index = loadIndex();
---

<BaseLayout title="Sources" description="Every source used in the briefing, in APA style.">
  <div class="container-wide py-16">
    <section id="references" class="max-w-3xl scroll-mt-20">
      <h1 class="text-5xl">References</h1>
      <ol class="reference-list mt-8 text-ink-2">
        {
          index.sources.map((s) => (
            <li id={s.id} class="scroll-mt-24 target:bg-sg-soft">
              {s.reference}{' '}
              <a href={s.url} class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink" target="_blank" rel="noopener">{s.url}</a>
              <span class="ml-2 text-xs text-muted">{s.claims.join(' · ')}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
