---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadIndex, citedClaimIds, claimsByGroup, loadNotUsed } from '../lib/sources.js';
import { TEAM } from '../lib/team.js';

const index = loadIndex();
const cited = citedClaimIds(index);
const groups = claimsByGroup(index);
const notUsed = loadNotUsed();
const verified = index.claims.filter((c) => c.verifiedBy).length;
---

<BaseLayout title="Sources" description="Every source used in the briefing in APA style, and the claim-by-claim verification table.">
  <div class="container-wide py-16">
    <div class="max-w-3xl">
      <h1 class="text-5xl">Sources</h1>
      <p class="mt-5 font-display text-xl leading-relaxed text-ink-2">
        Every fact in the briefing is a claim in the team's source table, and every claim rests on one source. {index.claims.length} claims draw on {index.sources.length} sources, all
        retrieved {TEAM.retrieved}. A team member opens each link, confirms the source says what the claim says, and initials the claim. Anything that fails comes off the site.
      </p>
      <p class="mt-4 text-sm text-muted">{verified} of {index.claims.length} claims verified so far. Edit <code class="rounded bg-paper-2 px-1.5 py-0.5 text-ink">src/data/sources.csv</code> to add or correct one.</p>
      <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium" aria-label="On this page">
        <a href="#references" class="underline decoration-ink/30 underline-offset-4 hover:decoration-ink">References</a>
        <a href="#verification" class="underline decoration-ink/30 underline-offset-4 hover:decoration-ink">Verification table</a>
        <a href="#not-used" class="underline decoration-ink/30 underline-offset-4 hover:decoration-ink">Not used</a>
      </nav>
    </div>

    <section id="references" class="mt-16 max-w-3xl scroll-mt-20">
      <h2 class="font-display text-3xl">References</h2>
      <ol class="reference-list mt-6 text-ink-2">
        {
          index.sources.map((s) => (
            <li id={s.id} class="scroll-mt-24 target:bg-sg-soft">
              {s.reference}{' '}
              <a href={s.url} class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink" target="_blank" rel="noopener">{s.url}</a>
              <span class="ml-2 text-xs text-muted">{s.claims.join(' · ')}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="verification" class="mt-20 scroll-mt-20">
      <h2 class="font-display text-3xl">Verification table</h2>
      <p class="mt-3 max-w-3xl text-ink-2">One row per claim, grouped by section. Open the link, check the quote against the claim, and add your initials in the Verified by column.</p>
      <div class="mt-6 space-y-3">
        {
          groups.map((g) => (
            <details class="group rounded-md border border-rule">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 font-medium text-ink">
                <span>{g.title}</span>
                <span class="text-sm font-normal text-muted">
                  {g.claims.length} claims, {g.claims.filter((c) => c.verifiedBy).length} verified
                </span>
              </summary>
              <div class="overflow-x-auto border-t border-rule">
                <table class="w-full min-w-[56rem] text-left text-sm">
                  <thead>
                    <tr class="border-b border-ink text-muted">
                      <th scope="col" class="px-4 py-2 font-normal">ID</th>
                      <th scope="col" class="py-2 pr-4 font-normal">Claim</th>
                      <th scope="col" class="py-2 pr-4 font-normal">Source</th>
                      <th scope="col" class="py-2 pr-4 font-normal">Verified by</th>
                    </tr>
                  </thead>
                  <tbody>
                    {g.claims.map((c) => {
                      const s = index.sourceByClaim.get(c.id);
                      return (
                        <tr class="border-b border-rule align-top">
                          <td class="num px-4 py-3 whitespace-nowrap text-ink">{c.id}</td>
                          <td class="py-3 pr-4 text-ink-2">
                            {c.claim}
                            {c.quote && <span class="mt-1 block text-muted italic">“{c.quote}”</span>}
                            {!cited.has(c.id) && <span class="mt-1 block text-xs text-muted">Not cited in the text yet</span>}
                          </td>
                          <td class="w-64 py-3 pr-4">
                            <a href={`#${s.id}`} class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink">{s.label}</a>
                            <a href={c.url} class="mt-1 block text-muted hover:text-ink" target="_blank" rel="noopener">Open link</a>
                          </td>
                          <td class="w-28 py-3 pr-4 text-ink">{c.verifiedBy || <span class="text-muted">Not yet</span>}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section id="not-used" class="mt-20 max-w-3xl scroll-mt-20">
      <h2 class="font-display text-3xl">Wanted, but not used</h2>
      <p class="mt-3 text-ink-2">Facts we could not retrieve from a source on {TEAM.retrieved}, so they are not in the briefing. The CIA World Factbook was discontinued on 4 February 2026.</p>
      <table class="mt-6 w-full text-left text-sm">
        <thead>
          <tr class="border-b border-ink text-muted">
            <th scope="col" class="py-2 pr-4 font-normal">What we wanted</th>
            <th scope="col" class="py-2 font-normal">Why it is not here</th>
          </tr>
        </thead>
        <tbody>
          {
            notUsed.map((r) => (
              <tr class="border-b border-rule align-top">
                <td class="py-3 pr-4 text-ink">{r.wanted}</td>
                <td class="py-3 text-ink-2">{r.why}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
