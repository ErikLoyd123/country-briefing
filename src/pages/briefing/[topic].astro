---
// Old link: the briefing was at /briefing/<section> before the site had desks. It is Politics & Risk's.
import { getTopics } from '../../lib/topics.js';
import { deskPath } from '../../lib/desks.js';

export async function getStaticPaths() {
  return (await getTopics('politics-risk')).map((t) => ({ params: { topic: t.slug } }));
}

return Astro.redirect(deskPath('politics-risk', `/briefing/${Astro.params.topic}`), 301);
---
