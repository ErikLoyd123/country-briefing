---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterOpener from '../../components/story/ChapterOpener.astro';
import StatusBadge from '../../components/layout/StatusBadge.astro';
import { mdxComponents } from '../../components/mdx.js';
import { getTopics } from '../../lib/topics.js';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((topic, i) => ({
    params: { topic: topic.slug },
    props: { topic, prev: topics[i - 1] ?? null, next: topics[i + 1] ?? null, total: topics.filter((t) => !t.conclusion).length },
  }));
}

const { topic, prev, next, total } = Astro.props;
// Slides brief: components check their claim IDs but leave citations to the paper and the Sources page.
Astro.locals.hideCitations = true;
const slides = topic.format === 'slides';
const [overview, singapore, vietnam] = await Promise.all((slides ? ['index'] : ['index', 'singapore', 'vietnam']).map((p) => render(topic.parts[p])));
const sections = [
  { id: 'overview', label: 'Overview', status: topic.parts.index.data.status },
  { id: 'singapore', label: 'Singapore', status: topic.parts.singapore?.data.status, color: 'bg-sg' },
  { id: 'vietnam', label: 'Vietnam', status: topic.parts.vietnam?.data.status, color: 'bg-vn' },
];
const pager = [
  prev ? { href: `/briefing/${prev.slug}`, label: 'Previous', title: prev.short } : { href: '/', label: 'Back to', title: 'Overview' },
  next ? { href: `/briefing/${next.slug}`, label: 'Next', title: next.short } : { href: '/sources', label: 'Next', title: 'Sources' },
];
---

<BaseLayout title={topic.title} description={topic.thesis}>
  <!-- On laptop-sized screens the page reads like a deck: the opener and every .frame fill one screen. -->
  <div class="opener-frame" data-frame>
    <ChapterOpener topic={topic} total={total} class="opener-media" />
  </div>

  {
    slides ? (
      <>
        <article class="briefing slides">
          <overview.Content components={mdxComponents} />
        </article>
        <nav aria-label="Slides in this section" class="slide-rail screen-only" data-slide-rail hidden>
          <ol></ol>
        </nav>
        <nav aria-label="Next and previous sections" class="screen-only container-wide mt-4 mb-16 grid gap-8 border-t border-ink pt-6 sm:grid-cols-2">
          {pager.map((l, i) => (
            <a href={l.href} class:list={['group block', i === 1 && 'sm:text-right']}>
              <span class="text-sm text-muted">{l.label}</span>
              <span class="mt-1 block font-display text-2xl leading-tight text-ink underline decoration-transparent decoration-1 underline-offset-[5px] group-hover:decoration-ink/40">{l.title}</span>
            </a>
          ))}
        </nav>
      </>
    ) : (
      <div class="container-wide grid gap-10 pt-14 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16 lg:pt-0">
        <nav aria-label="On this page" class="screen-only hidden lg:block">
          <div class="sticky top-24 mt-14">
          <ol class="space-y-1 border-l border-rule text-sm">
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-section-link={s.id} class="-ml-px flex items-center gap-2 border-l-2 border-transparent py-1.5 pl-4 text-ink-2 hover:text-ink">
                    {s.color && <span class:list={['size-2 rounded-full', s.color]} aria-hidden="true" />}
                    {s.label}
                  </a>
                  {s.status && <div class="pl-4"><StatusBadge status={s.status} /></div>}
                </li>
              ))
            }
          </ol>
          <p class="mt-6 pl-4 text-xs text-muted">Use the arrow keys to move between screens.</p>
          </div>
        </nav>

        <article class="briefing min-w-0 max-w-[52rem]">
          <section id="overview" class="briefing-prose scroll-mt-24">
            <overview.Content components={mdxComponents} />
          </section>

          <section id="singapore" class="briefing-prose country-section is-sg mt-20 scroll-mt-24 border-t-2 border-sg pt-2">
            <singapore.Content components={mdxComponents} />
          </section>

          <section id="vietnam" class="briefing-prose country-section is-vn mt-20 scroll-mt-24 border-t-2 border-vn pt-2">
            <vietnam.Content components={mdxComponents} />
          </section>

          <nav aria-label="Next and previous sections" class="screen-only mt-20 mb-4 grid gap-8 border-t border-ink pt-6 sm:grid-cols-2">
            {
              pager.map((l, i) => (
                <a href={l.href} class:list={['group block', i === 1 && 'sm:text-right']}>
                  <span class="text-sm text-muted">{l.label}</span>
                  <span class="mt-1 block font-display text-2xl leading-tight text-ink underline decoration-transparent decoration-1 underline-offset-[5px] group-hover:decoration-ink/40">{l.title}</span>
                </a>
              ))
            }
          </nav>
        </article>
      </div>
    )
  }
</BaseLayout>

<script>
  // Slides: a rail of dots down the right edge, one per slide, titled on hover and focus.
  const rail = document.querySelector('[data-slide-rail]');
  if (rail) {
    const slides = [...document.querySelectorAll('.slide[data-slide-title]')];
    const list = rail.querySelector('ol');
    const dots = slides.map((slide) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${slide.id}`;
      a.innerHTML = `<span class="slide-rail-label"></span>`;
      a.querySelector('span').textContent = slide.dataset.slideTitle;
      li.append(a);
      list.append(li);
      return a;
    });
    rail.hidden = slides.length === 0;
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          dots.forEach((a, i) => a.toggleAttribute('aria-current', slides[i] === e.target));
          rail.classList.toggle('is-on-night', e.target.dataset.tone === 'night' || e.target.dataset.layout === 'backdrop');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    slides.forEach((s) => seen.observe(s));
  }

  // Highlight the current section in the side rail.
  const links = new Map([...document.querySelectorAll('[data-section-link]')].map((a) => [a.dataset.sectionLink, a]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const [id, a] of links) {
          const on = id === e.target.id;
          a.classList.toggle('border-ink', on);
          a.classList.toggle('text-ink', on);
          a.classList.toggle('font-medium', on);
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  for (const id of links.keys()) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }

  // Screen-by-screen reading. Keep FRAME_QUERY in sync with the @media rule in the <style> below.
  const FRAME_QUERY = '(min-width: 1024px) and (min-height: 600px)';
  const frames = [...document.querySelectorAll('[data-frame], .briefing .frame')];
  const headerHeight = () => document.querySelector('header')?.getBoundingClientRect().height ?? 56;

  // ← / → (and PageUp / PageDown) move one screen at a time, like the presenter.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || !window.matchMedia(FRAME_QUERY).matches) return;
    if (e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable]')) return;
    const dir = { ArrowRight: 1, PageDown: 1, ArrowLeft: -1, PageUp: -1 }[e.key];
    if (!dir) return;
    const edge = headerHeight();
    const tops = frames.map((f) => f.getBoundingClientRect().top - edge);
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // A screen taller than the window: show the rest of it before moving on.
    const current = frames[tops.findLastIndex((t) => t <= 8)];
    const hidden = current ? current.getBoundingClientRect().bottom - window.innerHeight : 0;
    if (dir > 0 && hidden > 8) {
      e.preventDefault();
      window.scrollBy({ top: Math.min(hidden, window.innerHeight - edge), behavior: smooth ? 'smooth' : 'auto' });
      return;
    }
    const target = dir > 0 ? frames[tops.findIndex((t) => t > 8)] : frames[tops.findLastIndex((t) => t < -8)];
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
  });

  // In dev, flag any screen whose content is taller than the current window so the text can be trimmed.
  if (import.meta.env.DEV) {
    const flag = () => {
      const active = window.matchMedia(FRAME_QUERY).matches;
      const available = window.innerHeight - headerHeight();
      for (const f of frames) {
        const over = Math.round(f.getBoundingClientRect().height - available);
        if (active && over > 1) f.dataset.overflow = `${over}px taller than this screen`;
        else delete f.dataset.overflow;
      }
    };
    new ResizeObserver(flag).observe(document.body);
    window.addEventListener('resize', flag);
  }
</script>

<style>
  .is-sg {
    --country: var(--color-sg);
  }
  .is-vn {
    --country: var(--color-vn);
  }
  .briefing-prose :global(> :is(p, ul, ol, h2, h3)),
  .briefing-prose :global(> .frame > :is(p, ul, ol, h2, h3)) {
    max-width: 42rem;
  }
  .country-section :global(> .frame:first-child > h2:first-child) {
    margin-top: 1.25rem;
  }
  /* An overview that opens with a lone paragraph reads it as the section's lede. */
  #overview :global(> .frame:first-child > p:only-child) {
    max-width: 40rem;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.4;
    color: var(--color-ink);
  }

  /* Keep in sync with FRAME_QUERY in the script above. */
  @media screen and (min-width: 1024px) and (min-height: 600px) {
    :global(html:has(.briefing)) {
      scroll-snap-type: y proximity;
      scroll-padding-top: 3.5rem;
    }
    .opener-frame,
    .briefing :global(.frame) {
      min-height: calc(100svh - 3.5rem);
      scroll-snap-align: start;
    }
    .opener-frame {
      display: flex;
      flex-direction: column;
    }
    .opener-frame :global(.opener-media) {
      min-height: 0;
      flex: 1;
    }
    .briefing :global(.frame) {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    /* A slide's title keeps the same place on every screen, like a deck; its content centres in the room below. */
    .briefing :global(.frame.slide) {
      justify-content: flex-start;
    }
    .briefing :global(.slide > .slide-head) {
      margin-bottom: clamp(1.25rem, 3.5vh, 2.75rem);
    }
    /* Spare height goes a third above the content and two thirds below, so the content sits near its title. */
    .briefing :global(.slide > *) {
      order: 2;
    }
    .briefing :global(.slide > .slide-head) {
      order: 0;
    }
    .briefing :global(.slide > .slide-head + *) {
      margin-top: 0;
    }
    .briefing :global(.slide.frame:not([data-layout='backdrop'])::before),
    .briefing :global(.slide.frame:not([data-layout='backdrop'], [data-overflow])::after) {
      content: '';
      order: 1;
      flex-grow: 1;
    }
    .briefing :global(.slide.frame:not([data-layout='backdrop'], [data-overflow])::after) {
      order: 3;
      flex-grow: 2;
    }
    /* Q&A: the answer stays close under its question band; spare height goes below. */
    .briefing :global(.slide.frame[data-question]::before) {
      flex-grow: 0.3;
    }
    .briefing :global(.slide[data-question] > .qa-answer) {
      margin-top: clamp(1.5rem, 3.5vh, 2.5rem);
    }
    .briefing :global(.frame:not(.slide)) {
      padding-block: clamp(1.25rem, 5vh, 3rem);
    }
    .opener-frame :global(.opener-media .container-wide) {
      padding-top: clamp(2rem, 9vh, 8rem);
      padding-bottom: clamp(1.5rem, 6vh, 5rem);
    }

    /* Tall visuals shrink to the screen instead of spilling past it. The rem values
       reserve room for each figure's title, legend and source line. */
    .briefing :global(.frame .chart-frame astro-island > div[style]) {
      max-height: calc(100svh - 3.5rem - 22rem);
      min-height: 14rem;
    }
    .briefing :global(.frame .region-map svg) {
      max-height: calc(100svh - 3.5rem - 16rem);
    }
    .briefing :global(.frame figure img) {
      max-height: calc(100svh - 3.5rem - 9rem);
      object-fit: cover;
    }
    .briefing :global(.frame .heatmap :is(th, td)) {
      padding-block: 0.3rem;
    }
    .briefing :global(.frame .heatmap th[scope='rowgroup']) {
      padding-top: 0.6rem;
    }
    .briefing :global(.frame > :first-child) {
      margin-top: 0;
    }
    .briefing :global(.frame:not(.slide) > :last-child) {
      margin-bottom: 0;
    }

    /* Country sections open on a divider screen instead of a rule. */
    .country-section {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
    .country-section :global(> .frame:first-child > h2:first-child) {
      margin-top: 0;
      font-size: 3.5rem;
      line-height: 1.05;
    }
    .country-section :global(> .frame:first-child > h2:first-child)::before {
      content: '';
      display: block;
      width: 3rem;
      height: 4px;
      margin-bottom: 1.25rem;
      background: var(--country);
    }

    /* Dev-only overflow flag, set by the script above. */
    .briefing :global(.frame[data-overflow]),
    .opener-frame[data-overflow] {
      position: relative;
      outline: 2px dashed var(--color-risk-3);
      outline-offset: -2px;
    }
    .briefing :global(.frame[data-overflow])::after,
    .opener-frame[data-overflow]::after {
      content: attr(data-overflow);
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 5;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: var(--color-risk-4);
      color: white;
      font: 500 0.75rem/1.4 var(--font-sans);
    }
  }

  /* Slides: dot rail on the right edge. */
  .slide-rail {
    position: fixed;
    right: 1rem;
    top: 50%;
    z-index: 20;
    transform: translateY(-50%);
  }
  .slide-rail :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .slide-rail :global(a) {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
  }
  .slide-rail :global(a)::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 30%, transparent);
    transition: transform 150ms, background-color 150ms;
  }
  .slide-rail :global(a[aria-current])::before {
    background: var(--color-ink);
    transform: scale(1.5);
  }
  /* Over a dark slide the dots turn light. */
  .slide-rail.is-on-night :global(a)::before {
    background: color-mix(in srgb, var(--color-on-night) 45%, transparent);
  }
  .slide-rail.is-on-night :global(a[aria-current])::before {
    background: var(--color-on-night);
  }
  .slide-rail :global(.slide-rail-label) {
    position: absolute;
    right: 1.9rem;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms;
  }
  .slide-rail :global(a:is(:hover, :focus-visible) .slide-rail-label) {
    opacity: 1;
  }
  @media (max-width: 1023.98px) {
    .slide-rail {
      display: none;
    }
  }

  @media print {
    .country-section {
      break-before: page;
    }
  }
</style>
