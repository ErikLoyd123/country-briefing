---
// Shared chart chrome: title, legend, the interactive chart (screen), a data table
// (collapsible on screen, always shown in print), APA source line, sample badge.
import SampleBadge from '../story/SampleBadge.astro';
import { formatInText } from '../../lib/bib.js';

const { title, subtitle, sourceKeys = [], sample = false, legend = true, note } = Astro.props;
const source = await formatInText(sourceKeys);
const table = Astro.slots.has('table') ? await Astro.slots.render('table') : '';
---

<figure class="chart-frame not-prose my-12">
  <figcaption>
    <h3 class="font-display text-2xl leading-tight text-ink">{title}</h3>
    {subtitle && <p class="mt-1 text-[0.95rem] text-muted">{subtitle}</p>}
  </figcaption>

  {
    legend && (
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-2" aria-label="Legend">
        <li class="flex items-center gap-2">
          <span class="h-0.5 w-5 rounded bg-sg" aria-hidden="true" />
          Singapore
        </li>
        <li class="flex items-center gap-2">
          <span class="h-0.5 w-5 rounded bg-vn" aria-hidden="true" />
          Vietnam
        </li>
      </ul>
    )
  }

  <div class="screen-only mt-4">
    <slot />
  </div>

  {
    table && (
      <>
        <details class="screen-only mt-3 text-sm">
          <summary class="cursor-pointer text-muted hover:text-ink">View data table</summary>
          <div class="mt-3 overflow-x-auto" set:html={table} />
        </details>
        <div class="print-only mt-4" set:html={table} />
      </>
    )
  }

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-rule pt-3 text-xs text-muted">
    <span>{source && <>Source: {source}.</>} {note}</span>
    {sample && <SampleBadge />}
  </div>
</figure>

<style>
  @media print {
    .chart-frame {
      break-inside: avoid;
    }
  }
</style>
