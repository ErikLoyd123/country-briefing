---
// <RiskHeatmap dataset="scorecard" />   factor ratings from scorecard.yaml
// <RiskHeatmap dataset="industries" />  industry exposure from industries.yaml
// Plain HTML grid: readable, printable, and each cell names its value (not color alone).
import ChartFrame from './ChartFrame.astro';
import industriesRaw from '../../data/industries.yaml?raw';
import { loadYaml } from '../../lib/yaml.js';
import { scorecard, scorecardCiteKeys } from '../../lib/scorecard.js';
import { RISK_LABELS } from '../../lib/format.js';

const { dataset = 'scorecard', title, subtitle } = Astro.props;

let groups;
let sample;
let sourceKeys = [];
if (dataset === 'scorecard') {
  groups = scorecard.pillars.map((p) => ({ label: p.label, rows: p.factors.map((f) => ({ label: f.label, SG: f.ratings.SG.score, VN: f.ratings.VN.score })) }));
  sample = scorecard.sample;
  sourceKeys = scorecardCiteKeys();
} else if (dataset === 'industries') {
  const data = loadYaml(industriesRaw, 'src/data/industries.yaml');
  for (const i of data.industries) {
    for (const c of ['SG', 'VN']) {
      if (!Number.isInteger(i[c]) || i[c] < 1 || i[c] > 5) throw new Error(`industries.yaml: "${i.id}" ${c} must be an integer 1–5`);
    }
  }
  groups = [{ label: null, rows: data.industries.map((i) => ({ label: i.label, SG: i.SG, VN: i.VN })) }];
  sample = data.sample;
} else {
  throw new Error(`RiskHeatmap: unknown dataset "${dataset}" (use scorecard or industries)`);
}
const textOn = (score) => (score >= 3 ? 'text-white' : 'text-ink');
---

<ChartFrame
  title={title ?? (dataset === 'industries' ? 'Industry exposure' : 'Risk ratings by factor')}
  subtitle={subtitle ?? '1 (very low risk) to 5 (very high risk). Darker cells mean more risk.'}
  sourceKeys={sourceKeys}
  sample={sample}
  legend={false}
  note={dataset === 'industries' ? "Team assessment." : "Ratings are the team's assessment."}
>
  <div class="overflow-x-auto">
    <table class="heatmap w-full min-w-[30rem] border-separate border-spacing-[2px] text-sm">
      <thead>
        <tr>
          <th scope="col" class="sr-only">{dataset === 'industries' ? 'Industry' : 'Factor'}</th>
          <th scope="col" class="w-32 pb-1 text-center font-medium text-ink"><span class="mr-1.5 inline-block size-2 rounded-full bg-sg"></span>Singapore</th>
          <th scope="col" class="w-32 pb-1 text-center font-medium text-ink"><span class="mr-1.5 inline-block size-2 rounded-full bg-vn"></span>Vietnam</th>
        </tr>
      </thead>
      {
        groups.map((g) => (
          <tbody>
            {g.label && (
              <tr>
                <th scope="rowgroup" colspan="3" class="pt-4 pb-1 text-left text-xs font-medium text-muted">{g.label}</th>
              </tr>
            )}
            {g.rows.map((r) => (
              <tr>
                <th scope="row" class="py-2 pr-4 text-left font-normal text-ink">{r.label}</th>
                {(['SG', 'VN']).map((c) => (
                  <td
                    class:list={['cell num rounded-[4px] py-2 text-center font-medium', textOn(r[c])]}
                    style={`background: var(--color-risk-${r[c]})`}
                    title={`${r.label}, ${c === 'SG' ? 'Singapore' : 'Vietnam'}: ${r[c]} (${RISK_LABELS[r[c]].toLowerCase()})`}
                  >
                    {r[c]} <span class="font-normal opacity-85">{RISK_LABELS[r[c]]}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>
  <div class="mt-4 flex items-center gap-1 text-xs text-muted" aria-hidden="true">
    <span class="mr-2">Lower risk</span>
    {[1, 2, 3, 4, 5].map((n) => <span class="h-2.5 w-8 rounded-[2px]" style={`background: var(--color-risk-${n})`}></span>)}
    <span class="ml-2">Higher risk</span>
  </div>
</ChartFrame>

<style>
  .cell {
    transition: box-shadow 120ms;
  }
  .cell:hover {
    box-shadow: 0 0 0 2px var(--color-ink);
  }
  @media print {
    .heatmap td {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
