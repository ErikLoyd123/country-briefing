---
// columns: string[]; rows: (string|number)[][]. First column is a row header.
const { columns, rows } = Astro.props;
---

<table class="data-table w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-ink">
      {columns.map((c, i) => <th scope="col" class:list={['py-2 font-normal text-muted', i > 0 && 'text-right pl-4']}>{c}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr class="border-b border-rule">
          {r.map((cell, i) =>
            i === 0 ? (
              <th scope="row" class="py-1.5 pr-4 font-normal text-ink">{cell}</th>
            ) : (
              <td class="num py-1.5 pl-4 text-right text-ink">{cell}</td>
            ),
          )}
        </tr>
      ))
    }
  </tbody>
</table>
