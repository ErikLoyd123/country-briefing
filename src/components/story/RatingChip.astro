---
import { COUNTRY, RISK_LABELS } from '../../lib/format.js';

const { country, score, tone = 'light', size = 'sm' } = Astro.props;
const onNight = tone === 'dark';
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border',
    size === 'lg' ? 'py-1.5 pr-4 pl-1.5 text-base' : 'py-1 pr-3 pl-1 text-sm',
    onNight ? 'border-white/20 text-on-night' : 'border-rule bg-paper text-ink',
  ]}
>
  <span
    class:list={['num grid place-items-center rounded-full font-semibold', score >= 3 ? 'text-white' : 'text-ink', size === 'lg' ? 'size-8' : 'size-6 text-xs']}
    style={`background: var(--color-risk-${score})`}
    aria-hidden="true">{score}</span
  >
  <span>
    <span class:list={[country === 'SG' ? 'country-sg' : 'country-vn']}>{COUNTRY[country].name}</span>
    <span class:list={[onNight ? 'text-on-night-muted' : 'text-muted']}>{RISK_LABELS[score].toLowerCase()} risk</span>
  </span>
</span>

<style>
  .country-sg,
  .country-vn {
    font-weight: 500;
    margin-right: 0.3em;
  }
  .country-sg::before,
  .country-vn::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    border-radius: 999px;
    margin-right: 0.35em;
    vertical-align: 0.1em;
  }
  .country-sg::before {
    background: var(--color-sg);
  }
  .country-vn::before {
    background: var(--color-vn);
  }
</style>
