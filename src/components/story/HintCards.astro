---
// Practical tips as a grid of cards. Write a normal Markdown list inside; a bold lead-in becomes the card title.
// <HintCards title="Ten things to know on arrival">
// - **No visa for short visits.** US citizens can stay 90 days; keep six months on your passport [@SG-2].
// </HintCards>
// The card rule takes the country color of the section it sits in.
const { title = 'Know before you go' } = Astro.props;
---

<section class="hint-cards not-prose my-12">
  {title && <h3 class="font-display text-2xl text-ink">{title}</h3>}
  <div class="mt-5"><slot /></div>
</section>

<style>
  .hint-cards :global(ul),
  .hint-cards :global(ol) {
    display: grid;
    gap: 1.25rem 2rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .hint-cards :global(:is(ul, ol)) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .hint-cards :global(:is(ul, ol)) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .hint-cards :global(li) {
    border-top: 2px solid var(--country, var(--color-ink));
    padding-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
    break-inside: avoid;
  }
  .hint-cards :global(li > strong:first-child),
  .hint-cards :global(li > p:first-child > strong:first-child) {
    display: block;
    margin-bottom: 0.2rem;
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
