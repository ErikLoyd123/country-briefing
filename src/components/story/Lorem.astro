---
// <Lorem paragraphs={2} seed={4} /> — placeholder text showing where real writing goes.
// <Lorem words={12} /> renders a short inline phrase instead.
import { loremParagraphs, loremWords } from '../../lib/lorem.js';

const { paragraphs = 1, words, seed = 1 } = Astro.props;
---

{
  words ? (
    <span class="lorem">{loremWords(words, seed).join(' ')}</span>
  ) : (
    loremParagraphs(paragraphs, seed).map((p) => <p class="lorem">{p}</p>)
  )
}
