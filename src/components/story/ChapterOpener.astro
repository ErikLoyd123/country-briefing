---
// Full-bleed opener for a briefing topic. Uses hero.video / hero.image when present,
// otherwise a labeled placeholder describing the shot we still need.
import { Image } from 'astro:assets';
import PlaceholderMedia from './PlaceholderMedia.astro';
import RatingChip from './RatingChip.astro';
import { getCredit, creditLine } from '../../lib/credits.js';

const { topic, total } = Astro.props;
const { hero } = topic;
const images = import.meta.glob('/src/assets/images/**/*.{jpg,jpeg,png,webp,avif}');

let image;
let credit;
if (hero.image) {
  const loader = images[`/src/assets/images/${hero.image}`];
  if (!loader) throw new Error(`${topic.folder}/index.mdx hero.image "${hero.image}" not found in src/assets/images/`);
  image = (await loader()).default;
  credit = getCredit(hero.image);
}
if (hero.video) credit = getCredit(hero.video);
---

<section class="chapter-opener relative isolate flex min-h-[78svh] items-end overflow-hidden bg-night text-on-night">
  {
    hero.video ? (
      <video class="absolute inset-0 -z-10 h-full w-full object-cover" autoplay muted loop playsinline poster={hero.poster} aria-label={hero.alt}>
        <source src={`/media/${hero.video}`} />
      </video>
    ) : image ? (
      <Image src={image} alt={hero.alt} widths={[960, 1600, 2400]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="eager" />
    ) : (
      <div class="absolute inset-0 -z-10">
        <PlaceholderMedia label={hero.label} tone="dark" fill />
      </div>
    )
  }
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night via-night/60 to-night/10" aria-hidden="true"></div>

  <div class="container-wide pt-32 pb-14 md:pb-20">
    <p class="kicker text-on-night-muted">Briefing {topic.order} of {total}</p>
    <h1 class="mt-3 max-w-4xl text-5xl leading-[1.02] md:text-7xl">{topic.title}</h1>
    <p class="mt-6 max-w-2xl font-display text-xl leading-snug text-on-night/85 md:text-2xl">{topic.thesis}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <RatingChip country="SG" score={topic.ratings.SG} tone="dark" size="lg" />
      <RatingChip country="VN" score={topic.ratings.VN} tone="dark" size="lg" />
    </div>
    {credit && <p class="mt-8 text-xs text-on-night-muted">{creditLine(credit)}</p>}
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
  @media print {
    .chapter-opener {
      min-height: 0;
      background: none;
      color: var(--color-ink);
    }
    .chapter-opener video,
    .chapter-opener img,
    .chapter-opener [role='img'] {
      display: none;
    }
  }
</style>
