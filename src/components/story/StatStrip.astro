---
// Latest value for each indicator, Singapore next to Vietnam.
import AnimatedNumber from '../ui/AnimatedNumber.jsx';
import SampleBadge from './SampleBadge.astro';
import { getLatest } from '../../lib/data.js';
import { formatValue, UNIT_LABEL } from '../../lib/format.js';
import { numberParts } from '../../lib/numberParts.js';

const { ids = [] } = Astro.props;
const stats = ids.map(getLatest);
const anySample = stats.some((s) => s.sample);
---

{
  stats.length > 0 && (
    <section class="border-b border-rule bg-paper" aria-label="Key numbers">
      <div class="container-wide py-8">
        <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-[repeat(var(--n),minmax(0,1fr))]" style={`--n:${stats.length}`}>
          {stats.map((s) => (
            <div>
              <p class="text-sm text-muted">
                {s.meta.short ?? s.meta.label}
                <span class="text-muted/70"> ({UNIT_LABEL[s.meta.unit]}{s.meta.higherIsBetter ? ', higher is better' : ', lower is better'})</span>
              </p>
              <dl class="mt-3 grid grid-cols-2 gap-4">
                {(['SG', 'VN']).map((c) => {
                  const row = s[c];
                  const parts = row ? numberParts(row.value, s.meta.unit) : null;
                  return (
                    <div class:list={['border-l-2 pl-3', c === 'SG' ? 'border-sg' : 'border-vn']}>
                      <dt class="text-xs text-muted">{c === 'SG' ? 'Singapore' : 'Vietnam'}{row && `, ${row.year}`}</dt>
                      <dd class="num mt-1 text-3xl font-semibold tracking-tight text-ink">
                        {row ? (
                          <>
                            <span class="screen-only"><AnimatedNumber client:visible {...parts} /></span>
                            <span class="print-only">{formatValue(row.value, s.meta.unit)}</span>
                          </>
                        ) : '—'}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </div>
          ))}
        </div>
        {anySample && <SampleBadge class="mt-6" />}
      </div>
    </section>
  )
}
