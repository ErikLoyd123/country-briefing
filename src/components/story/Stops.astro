---
// A day-by-day visit list. Wrap <Stop> entries:
// <Stops title="Singapore, 3 to 7 November">
// <Stop when="Wed 4 Nov, 9:00" name="Emerson (industrial automation)">
// What the stop reveals [@SG-83].
//
// <Fragment slot="ask">The one question to ask.</Fragment>
// </Stop>
// </Stops>
const { title } = Astro.props;
---

<section class="not-prose my-12">
  {title && <h3 class="font-display text-2xl text-ink">{title}</h3>}
  <ol class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    <slot />
  </ol>
</section>
