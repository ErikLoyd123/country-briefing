---
// Flags invented draft data so it can't slip into the final deliverable unnoticed.
const { class: className } = Astro.props;
---

<span
  class:list={['inline-flex items-center gap-1 rounded-full border border-sample/40 bg-sample/8 px-2 py-0.5 text-[0.7rem] font-medium text-sample', className]}
  title="Placeholder values for layout. Replace with sourced data and set sample=false."
>
  <span class="size-1.5 rounded-full bg-sample" aria-hidden="true"></span>
  Sample data
</span>
