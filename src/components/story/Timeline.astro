---
// Two-lane timeline from the desk's src/data/<desk>/timeline.yaml: Singapore left, Vietnam right.
import { loadDeskYaml } from '../../lib/yaml.js';
import { siteCitation } from '../../lib/sources.js';

// bare: no title or outer margin, for use inside a <Slide> that titles it.
// brief: dates and titles only, for a slide; the paper keeps each event's detail.
const { title = 'Key political events', from, bare = false, brief = false, legend = true } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const events = loadDeskYaml(Astro.locals.desk, 'timeline.yaml', 'Timeline')
  .map((e) => {
    if (!/^\d{4}-\d{2}$/.test(e.date)) throw new Error(`timeline.yaml: date "${e.date}" must be YYYY-MM`);
    if (e.end && !/^\d{4}-\d{2}$/.test(e.end)) throw new Error(`timeline.yaml: end "${e.end}" must be YYYY-MM`);
    if (!['SG', 'VN', 'both'].includes(e.country)) throw new Error(`timeline.yaml: "${e.title}" country must be SG, VN or both`);
    return e;
  })
  .filter((e) => !from || e.date >= from)
  .sort((a, b) => a.date.localeCompare(b.date));
const hasBoth = events.some((e) => e.country === 'both');
const month = (d) => MONTHS[Number(d.slice(5)) - 1];
const label = (d) => `${month(d)} ${d.slice(0, 4)}`;
// A span in one year reads "Apr to Jul 2025"; across years, "Nov 2025 to Feb 2026".
const span = (e) => {
  if (!e.end) return label(e.date);
  return e.end.slice(0, 4) === e.date.slice(0, 4) ? `${month(e.date)} to ${label(e.end)}` : `${label(e.date)} to ${label(e.end)}`;
};
---

<section class:list={['not-prose', !bare && 'my-14', brief && 'is-brief']}>
  {
    !bare && (
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="font-display text-2xl text-ink">{title}</h3>
      </div>
    )
  }
  <div class="mt-3 hidden grid-cols-[1fr_5.5rem_1fr] text-sm font-medium md:grid lg:hidden" aria-hidden="true">
    <span class="text-right text-ink">Singapore</span><span></span><span class="text-ink">Vietnam</span>
  </div>
  <ul class:list={['mt-3 hidden gap-5 text-sm text-ink-2', legend && 'lg:flex', bare && 'justify-center']} aria-label="Legend">
    <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-sg" aria-hidden="true" />Singapore</li>
    <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-vn" aria-hidden="true" />Vietnam</li>
    {hasBoth && <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-ink" aria-hidden="true" />Both countries</li>}
  </ul>
  <ol class="timeline relative mt-4" style={`--cols:${events.length + 1}`}>
    {
      events.map((e, i) => (
        <li class:list={['tl-item', `is-${e.country.toLowerCase()}`, i % 2 ? 'is-below' : 'is-above']} style={`--col:${i + 1}`}>
          <time class="tl-date num" datetime={e.date}>{span(e)}</time>
          <div class="tl-card">
            <p class="tl-country text-xs text-muted">{e.country === 'SG' ? 'Singapore' : e.country === 'VN' ? 'Vietnam' : 'Both countries'}</p>
            <p class="font-medium text-ink">{e.title}</p>
            {brief ? (
              <Fragment set:html={siteCitation(Astro.locals, e.cite, `timeline.yaml (${e.title})`)} />
            ) : (
              <p class="mt-1 text-[0.95rem] text-ink-2">{e.detail} <Fragment set:html={siteCitation(Astro.locals, e.cite, `timeline.yaml (${e.title})`)} /></p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Phones: one lane down the left. Tablets: Singapore left, Vietnam right of a center axis.
     Laptops and up: a horizontal axis with events alternating above and below, so the whole
     timeline fits on one screen. */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.35rem;
    width: 1px;
    background: var(--color-rule);
  }
  .tl-item {
    position: relative;
    padding: 0 0 1.5rem 1.75rem;
    break-inside: avoid;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    box-shadow: 0 0 0 2px var(--color-paper);
    background: var(--color-ink);
  }
  .tl-item.is-sg::before {
    background: var(--color-sg);
  }
  .tl-item.is-vn::before {
    background: var(--color-vn);
  }
  .tl-date {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .tl-card {
    margin-top: 0.15rem;
  }
  .is-brief .tl-card {
    font-family: var(--font-display);
  }
  .is-brief .tl-card .font-medium {
    font-weight: 450;
  }

  @media (min-width: 768px) and (max-width: 1023.98px) {
    .tl-country {
      display: none;
    }
    .timeline::before {
      left: 50%;
    }
    .tl-item {
      display: grid;
      grid-template-columns: 1fr 5.5rem 1fr;
      padding: 0 0 1.25rem;
    }
    .tl-item::before {
      left: calc(50% - 0.375rem);
    }
    .tl-date {
      grid-column: 2;
      grid-row: 1;
      text-align: center;
      padding-top: 1.1rem;
    }
    .tl-item.is-sg .tl-card {
      grid-column: 1;
      grid-row: 1;
      text-align: right;
    }
    .tl-item.is-vn .tl-card {
      grid-column: 3;
      grid-row: 1;
    }
    .tl-item.is-both .tl-card {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      text-align: center;
      max-width: 28rem;
      background: var(--color-paper);
      padding: 0.25rem 0.75rem;
      position: relative;
    }
  }

  @media (min-width: 1024px) {
    .timeline {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      grid-template-rows: auto 2.5rem auto;
    }
    /* The axis: a grid item spanning the middle row. */
    .timeline::before {
      position: static;
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: center;
      width: auto;
      height: 1px;
    }
    .tl-item {
      grid-column: var(--col) / span 2;
      padding: 0 1rem 0 0;
    }
    .tl-item.is-above {
      grid-row: 1;
      align-self: end;
      padding-bottom: 0.75rem;
    }
    .tl-item.is-below {
      grid-row: 3;
      align-self: start;
      padding-top: 0.75rem;
    }
    .tl-item::before {
      top: auto;
      left: 0;
    }
    .tl-item.is-above::before {
      bottom: -1.625rem;
    }
    .tl-item.is-below::before {
      top: -1.625rem;
    }
    /* Tick from the text to its dot. */
    .tl-item::after {
      content: '';
      position: absolute;
      left: calc(0.375rem - 0.5px);
      width: 1px;
      height: 0.875rem;
      background: var(--color-rule);
    }
    .tl-item.is-above::after {
      bottom: -0.875rem;
    }
    .tl-item.is-below::after {
      top: -0.875rem;
    }
    .tl-card {
      margin-top: 0.1rem;
      font-size: 0.9rem;
      line-height: 1.35;
    }
    .tl-card p:last-child {
      font-size: 0.85rem;
    }
    /* Brief (on a slide): larger titles and more air, since there is no detail line. */
    .is-brief .timeline {
      grid-template-rows: auto 4rem auto;
    }
    .is-brief .tl-item.is-above {
      padding-bottom: 1.25rem;
    }
    .is-brief .tl-item.is-below {
      padding-top: 1.25rem;
    }
    .is-brief .tl-item.is-above::before {
      bottom: -2.5rem;
    }
    .is-brief .tl-item.is-below::before {
      top: -2.5rem;
    }
    .is-brief .tl-item::after {
      height: 1.75rem;
    }
    .is-brief .tl-item.is-above::after {
      bottom: -1.75rem;
    }
    .is-brief .tl-item.is-below::after {
      top: -1.75rem;
    }
    .is-brief .tl-card,
    .is-brief .tl-card p:last-child {
      font-size: clamp(1.05rem, 1.3vw, 1.3rem);
      line-height: 1.2;
    }
    .is-brief .tl-date {
      font-size: 0.9rem;
    }
  }
</style>
