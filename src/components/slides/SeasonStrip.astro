---
// A year as twelve months, with each country's weather seasons as bands and dated markers
// (a trip, a holiday) drawn across both.
// <SeasonStrip rows={[
//   { country: 'SG', label: 'Monsoons', spans: [{ from: '12-01', to: '03-10' }, { from: '06-01', to: '09-30' }], cite: ['SG-11'] },
// ]} markers={[{ label: 'Our trip', from: '11-03', to: '11-13' }]} />
// Dates are MM-DD. A span whose `to` is earlier than `from` wraps over the new year.
// temps: { place, high: [12 °C], low: [12 °C], cite } adds each month's average daily high and low under the row,
// shown in °F with °C on hover.
import { siteCitation } from '../../lib/sources.js';

const { rows = [], markers = [] } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
const dayOfYear = (md) => {
  const [m, d] = md.split('-').map(Number);
  return DAYS.slice(0, m - 1).reduce((a, b) => a + b, 0) + d - 1;
};
const pct = (md, end = false) => ((dayOfYear(md) + (end ? 1 : 0)) / 365) * 100;
const segments = (span) => {
  const a = pct(span.from);
  const b = pct(span.to, true);
  return b > a ? [[a, b]] : [[a, 100], [0, b]];
};
const NAMES = { SG: 'Singapore', VN: 'Vietnam' };
const toF = (c) => Math.round((c * 9) / 5 + 32);
for (const r of rows) {
  if (r.temps && (r.temps.high?.length !== 12 || r.temps.low?.length !== 12)) throw new Error(`SeasonStrip (${r.label}): temps needs 12 highs and 12 lows`);
}
---

<figure class="season">
  <div class="season-grid">
    <div class="season-months" aria-hidden="true">
      {MONTHS.map((m) => <span>{m}</span>)}
    </div>
    {
      rows.map((r) => (
        <div class:list={['season-row', `is-${r.country.toLowerCase()}`]}>
          <p class="season-label">
            <span class="season-dot" aria-hidden="true" />
            <span>
              {NAMES[r.country]}: {r.label} <Fragment set:html={siteCitation(Astro.locals, r.cite, `SeasonStrip (${r.label})`)} />
            </span>
          </p>
          <div class="season-track">
            {r.spans.map((s) => segments(s).map(([a, b]) => <span class="season-band" style={`left:${a}%; width:${b - a}%`} />))}
          </div>
        </div>
      ))
    }
    <div class="season-markers" aria-hidden="true">
      {
        markers.map((m) => (
          <span class:list={['season-marker', m.tone === 'soft' && 'is-soft']} style={`left:${pct(m.from)}%; width:${Math.max(pct(m.to, true) - pct(m.from), 0.8)}%`}>
            <span class="season-marker-label">{m.label}</span>
          </span>
        ))
      }
    </div>
  </div>
  {
    rows.some((r) => r.temps) && (
      <div class="season-temps-block">
        <p class="season-temps-head">Average daily high and low, °F</p>
        {rows
          .filter((r) => r.temps)
          .map((r) => (
            <div class:list={['season-temps-row', `is-${r.country.toLowerCase()}`]}>
              <p class="season-temps-label">
                <span class="season-dot" aria-hidden="true" />
                <span>
                  {r.temps.place} <Fragment set:html={siteCitation(Astro.locals, r.temps.cite, `SeasonStrip (${r.temps.place} temperatures)`)} />
                </span>
              </p>
              <ol class="season-temps">
                {MONTHS.map((m, i) => (
                  <li title={`${m}: ${r.temps.high[i]}°C high, ${r.temps.low[i]}°C low`}>
                    <span class="sr-only">{m}: </span>
                    <span class="season-high num">{toF(r.temps.high[i])}°</span>
                    <span class="sr-only"> high, </span>
                    <span class="season-low num">{toF(r.temps.low[i])}°</span>
                    <span class="sr-only"> low</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
      </div>
    )
  }
  {
    markers.length > 0 && (
      <ul class="sr-only">
        {markers.map((m) => (
          <li>
            {m.label}: {m.from} to {m.to}
          </li>
        ))}
      </ul>
    )
  }
</figure>

<style>
  .is-sg {
    --country: var(--color-sg);
  }
  .is-vn {
    --country: var(--color-vn);
  }
  .season {
    --label-w: 0rem;
  }
  .season-grid {
    position: relative;
    padding-bottom: 2.25rem;
  }
  @media (min-width: 768px) {
    .season {
      --label-w: 13rem;
    }
    .season-row {
      display: grid;
      grid-template-columns: var(--label-w) minmax(0, 1fr);
      align-items: center;
    }
    .season-label {
      padding-right: 1rem;
    }
    .season-row .season-track {
      margin-top: 0;
    }
  }
  .season-months {
    margin-left: var(--label-w);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .season-months span {
    padding: 0 0 0.4rem 0.35rem;
    border-left: 1px solid var(--color-rule);
  }
  .season-row {
    margin-top: 0.9rem;
  }
  .season-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .season-dot {
    flex: none;
    transform: translateY(-0.05rem);
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--country);
  }
  .season-track {
    position: relative;
    height: 2.25rem;
    margin-top: 0.35rem;
    border-radius: 3px;
    background: repeating-linear-gradient(to right, var(--color-paper-2) 0 calc(100% / 12 - 1px), var(--color-paper) calc(100% / 12 - 1px) calc(100% / 12));
  }
  .season-temps-block {
    margin-top: 0.5rem;
  }
  .season-temps-head {
    margin-left: var(--label-w);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .season-temps-row {
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .season-temps-row {
      display: grid;
      grid-template-columns: var(--label-w) minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .season-temps-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-right: 1rem;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .season-temps {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    font-size: clamp(0.62rem, 0.9vw, 0.85rem);
    line-height: 1.2;
  }
  .season-temps li {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3rem;
    padding-left: 0.35rem;
    border-left: 1px solid var(--color-rule);
  }
  .season-high {
    font-weight: 600;
    color: var(--color-ink);
  }
  .season-low {
    color: var(--color-muted);
  }
  .season-band {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 3px;
    background: var(--country);
  }
  .season-markers {
    position: absolute;
    inset: 1.4rem 0 0 var(--label-w);
    pointer-events: none;
  }
  .season-marker {
    position: absolute;
    top: 0;
    bottom: 1.6rem;
    border-inline: 2px solid var(--color-ink);
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
  .season-marker.is-soft {
    border-style: dashed;
    border-color: var(--color-ink-2);
    background: transparent;
  }
  .season-marker-label {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 0.3rem;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
