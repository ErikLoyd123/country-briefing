---
// The trip as a row of days: each country's days sit under its photo, and each day lists its visits.
// <TripStrip days={[
//   { date: '2026-11-03', country: 'SG' },
//   { date: '2026-11-04', country: 'SG', stops: ['Emerson', 'Swapaholic'] },
//   …
// ]} sg={{ city: 'Singapore', media: 'singapore/marina-bay-night.jpg' }} vn={{ city: 'Ho Chi Minh City', media: 'vietnam/saigon-skyline.jpg' }} />
// Days run in the order given; a country's days must be consecutive.
// map: a small route map inset in the corner.
import HeroMedia from '../story/HeroMedia.astro';
import { findCredit } from '../../lib/credits.js';
import TripMap from '../maps/TripMap.astro';

const { days = [], sg = {}, vn = {}, map = false } = Astro.props;
const WEEKDAY = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const parsed = days.map((d) => {
  const [y, m, day] = d.date.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, day));
  return { ...d, weekday: WEEKDAY[dt.getUTCDay()], day, month: MONTH[m - 1] };
});
const groups = ['SG', 'VN']
  .map((code) => {
    const info = code === 'SG' ? sg : vn;
    const list = parsed.filter((d) => d.country === code);
    if (!list.length) return null;
    const credit = info.media ? findCredit(info.media) : null;
    if (info.media && !credit) throw new Error(`TripStrip: "${info.media}" has no credits.yaml entry`);
    const video = info.media?.endsWith('.mp4');
    return { code, info, list, credit, video, first: list[0], last: list.at(-1) };
  })
  .filter(Boolean);
---

<div class="trip" style={`--days: ${parsed.length}`}>
  {
    map && (
      <div class="trip-inset">
        <TripMap />
      </div>
    )
  }
  {
    groups.map((g) => (
      <section class:list={['trip-leg', `is-${g.code.toLowerCase()}`]} style={`--span: ${g.list.length}`}>
        <div class="trip-photo">
          {g.info.media && <HeroMedia image={g.video ? undefined : g.info.media} video={g.video ? g.info.media : undefined} alt={g.credit.alt} sizes="(min-width: 1024px) 40rem, 100vw" />}
          <p class="trip-city">
            <span class="trip-city-name">{g.info.city}</span>
            <span class="trip-city-dates num">
              {g.first.day} to {g.last.day} {g.last.month}
            </span>
          </p>
        </div>
        <ol class="trip-days">
          {g.list.map((d) => (
            <li class:list={['trip-day', !d.stops?.length && 'is-free']}>
              <p class="trip-date">
                <span>{d.weekday}</span> <span class="type-heavy num">{d.day}</span>
              </p>
              {d.stops?.length ? (
                <ul class="trip-stops">
                  {d.stops.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="trip-none" aria-label="No visits">–</p>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .trip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--days), minmax(0, 1fr));
    gap: 0 clamp(0.75rem, 1.6vw, 1.5rem);
    font-family: var(--font-sans);
  }
  .trip-inset {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    width: clamp(9rem, 14vw, 13rem);
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-night) 25%, transparent), 0 6px 18px color-mix(in srgb, var(--color-night) 35%, transparent);
  }
  .is-sg {
    --country: var(--color-sg);
  }
  .is-vn {
    --country: var(--color-vn);
  }
  .trip-leg {
    grid-column: span var(--span);
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
  }
  .trip-photo {
    position: relative;
    isolation: isolate;
    height: clamp(9rem, 30svh, 17rem);
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-night);
  }
  .trip-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-night) 80%, transparent), transparent 55%);
  }
  .trip-city {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    color: var(--color-on-night);
  }
  .trip-city-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
    line-height: 1.05;
  }
  .trip-city-dates {
    font-size: 0.9rem;
    color: var(--color-on-night-muted);
  }
  .trip-days {
    display: grid;
    grid-template-columns: repeat(var(--span), minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    margin-top: 0.9rem;
  }
  .trip-day {
    min-width: 0;
    padding-top: 0.6rem;
    border-top: 3px solid var(--country);
  }
  .trip-day.is-free {
    border-top-color: color-mix(in srgb, var(--country) 30%, transparent);
  }
  .trip-date {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .trip-date .type-heavy {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1;
    color: var(--color-ink);
  }
  .is-free .trip-date .type-heavy {
    color: var(--color-muted);
  }
  .trip-stops {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.6rem;
  }
  .trip-stops li {
    padding-left: 0.5rem;
    border-left: 2px solid color-mix(in srgb, var(--country) 45%, transparent);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.2;
    color: var(--color-ink);
  }
  .trip-none {
    margin-top: 0.4rem;
    color: var(--color-muted);
  }

  @media (max-width: 899.98px) {
    .trip-inset {
      display: none;
    }
    .trip {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .trip-leg {
      grid-column: auto;
    }
    .trip-photo {
      height: auto;
      aspect-ratio: 16 / 7;
    }
    .trip-days {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
