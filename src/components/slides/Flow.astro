---
// A short process drawn as steps down a line. The number of steps is the point: compare a
// two-step country with a five-step one.
// <Flow country="VN" steps={[
//   { title: 'Audited accounts' },
//   { title: 'Tax finalisation' },
//   { title: 'Money leaves', tone: 'end' },
// ]} />
// tone: "end" (the outcome), "stop" (a dead end, drawn in the warning color).
const { country, steps = [] } = Astro.props;
---

<ol class:list={['flow', country && `is-${country.toLowerCase()}`]}>
  {
    steps.map((s) => (
      <li class:list={['flow-step', s.tone && `is-${s.tone}`]}>
        <span class="flow-node" aria-hidden="true" />
        <p class="flow-title">{s.title}</p>
        {s.detail && <p class="flow-detail">{s.detail}</p>}
      </li>
    ))
  }
</ol>

<style>
  .is-sg {
    --country: var(--color-sg);
  }
  .is-vn {
    --country: var(--color-vn);
  }
  .flow {
    position: relative;
    display: grid;
    gap: 0.9rem;
  }
  .flow-step {
    position: relative;
    padding-left: 2.25rem;
  }
  /* The line down to the next step. */
  .flow-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.6rem;
    top: 1.2rem;
    bottom: -1.3rem;
    width: 2px;
    background: var(--country, var(--color-ink));
  }
  .flow-node {
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 999px;
    border: 2px solid var(--country, var(--color-ink));
    background: var(--color-paper);
  }
  .flow-step.is-end .flow-node {
    background: var(--country, var(--color-ink));
  }
  .flow-step.is-stop .flow-node {
    border-color: var(--color-risk-4);
    background: var(--color-risk-4);
  }
  .flow-step.is-stop::before {
    display: none;
  }
  .flow-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .flow-step.is-stop .flow-title {
    color: var(--color-risk-4);
  }
  .flow-detail {
    margin-top: 0.1rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  @media (min-width: 768px) and (max-height: 820px) {
    .flow {
      gap: 0.6rem;
    }
    .flow-step:not(:last-child)::before {
      bottom: -1rem;
    }
  }
</style>
