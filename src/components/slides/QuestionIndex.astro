---
// Every question in a Q&A section, numbered and linked to its slide, for jumping straight to one
// when it is asked. Reads the <Slide question={n}> tags written in the section.
// <QuestionIndex section="questions" />
import { getQuestions } from '../../lib/questions.js';

const questions = getQuestions(Astro.locals.desk, Astro.props.section);
---

<ol class="qindex">
  {
    questions.map((q) => (
      <li>
        <a href={`#q${q.number}`}>
          <span class="qindex-num type-heavy num">Q{q.number}</span>
          <span class="qindex-text">{q.title}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .qindex {
    display: grid;
    max-width: 72rem;
    margin-inline: auto;
    column-gap: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 900px) {
    .qindex {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(6, auto);
    }
  }
  .qindex li {
    border-top: 1px solid var(--color-rule);
  }
  .qindex a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.6rem, 1.6vh, 0.95rem);
    color: var(--color-ink);
  }
  .qindex-num {
    flex: none;
    width: 2.6rem;
    font-size: 1rem;
    color: var(--color-muted);
    transition: color 120ms;
  }
  .qindex-text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 120ms;
  }
  .qindex a:is(:hover, :focus-visible) .qindex-num {
    color: var(--color-ink);
  }
  .qindex a:is(:hover, :focus-visible) .qindex-text {
    text-decoration-color: color-mix(in srgb, var(--color-ink) 40%, transparent);
  }
</style>
