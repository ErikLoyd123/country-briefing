---
// A risk in brief, for a slide: the team's level, the headline, one line of evidence, and what
// it means for a company. The homepage lists every RiskCard by area, level, title and country.
// <RiskCard country="VN" area="security" level="high" title="Weather is the disaster risk">
// Typhoon Yagi killed 318 people in 2024 [@VN-36].
// <Fragment slot="means">Plan flood and power contingency.</Fragment>
// </RiskCard>
import RiskLevel from '../story/RiskLevel.astro';
import { AREAS, riskAnchor } from '../../lib/format.js';

const { country, area, level, title } = Astro.props;
if (!['SG', 'VN'].includes(country)) throw new Error(`RiskCard "${title}": country must be SG or VN`);
if (!AREAS[area]) throw new Error(`RiskCard "${title}": area "${area}" should be one of ${Object.keys(AREAS).join(', ')}`);
---

<article id={riskAnchor(title)} class="riskcard">
  <RiskLevel level={level} class="riskcard-level" />
  <h3 class="riskcard-title">{title}</h3>
  <div class="riskcard-body"><slot /></div>
  {
    Astro.slots.has('means') && (
      <div class="riskcard-means">
        <span class="riskcard-so">So: </span>
        <slot name="means" />
      </div>
    )
  }
</article>

<style>
  .riskcard {
    scroll-margin-top: 5rem;
  }
  .riskcard + :global(.riskcard) {
    margin-top: clamp(0.7rem, 1.8vh, 1.2rem);
    padding-top: clamp(0.7rem, 1.8vh, 1.2rem);
    border-top: 1px solid var(--color-rule);
  }
  .riskcard :global(.riskcard-level) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    padding-block: 0.15rem;
  }
  .riskcard-title {
    margin-top: 0.35rem;
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    line-height: 1.15;
    color: var(--color-ink);
  }
  .riskcard-body {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }
  .riskcard-means {
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .riskcard-means :global(p) {
    display: inline;
  }
  .riskcard-so {
    font-weight: 600;
  }

  @media (min-width: 768px) and (max-height: 820px) {
    .riskcard-title {
      font-size: 1.15rem;
    }
    .riskcard-body {
      font-size: 0.95rem;
      line-height: 1.35;
    }
    .riskcard-means {
      font-size: 0.85rem;
    }
  }
</style>
