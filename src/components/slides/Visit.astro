---
// One stop on the trip, for a slide: when, who, the risk it shows, and the question to ask.
// <Visit when="Wed 4 Nov, 9:00" name="Emerson" kind="industrial automation">
// What the stop reveals [@SG-83].
// <Fragment slot="ask">The one question to ask.</Fragment>
// </Visit>
// media: an optional photo (src/assets/images/) or video (public/media/, .mp4) above the card.
import HeroMedia from '../story/HeroMedia.astro';
import { findCredit } from '../../lib/credits.js';

const { when, name, kind, media } = Astro.props;
const credit = media ? findCredit(media) : null;
if (media && !credit) throw new Error(`Visit "${name}": "${media}" has no credits.yaml entry. Add it to media-sources.yaml and run npm run media.`);
const video = media?.endsWith('.mp4');
---

<article class:list={['visit', media && 'has-media']}>
  {
    media && (
      <div class="visit-media">
        <HeroMedia image={video ? undefined : media} video={video ? media : undefined} alt={credit.alt} sizes="(min-width: 768px) 26rem, 100vw" />
      </div>
    )
  }
  <p class="visit-when num">{when}</p>
  <h3 class="visit-name">{name}</h3>
  {kind && <p class="visit-kind">{kind}</p>}
  <div class="visit-body"><slot /></div>
  {
    Astro.slots.has('ask') && (
      <div class="visit-ask">
        <p class="visit-ask-label">Ask</p>
        <div class="visit-ask-text">
          <slot name="ask" />
        </div>
      </div>
    )
  }
</article>

<style>
  .visit {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  /* In a grid of visits, each card's parts share rows with its neighbours, so the questions line up. */
  @supports (grid-template-rows: subgrid) {
    .visit {
      display: grid;
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
      align-content: start;
    }
    .visit:not(.has-media)::before {
      content: '';
    }
    /* An auto margin would still push the question to the bottom of its shared row. */
    .visit .visit-ask {
      margin-top: 0;
    }
  }
  .visit {
    padding-top: 0.9rem;
    border-top: 2px solid var(--country, var(--color-ink));
  }
  .visit.has-media {
    padding-top: 0;
    border-top: 0;
  }
  .visit-media {
    position: relative;
    aspect-ratio: 2.2 / 1;
    max-height: 22svh;
    margin-bottom: 0.8rem;
    overflow: hidden;
    border-radius: 4px;
    border-bottom: 3px solid var(--country, var(--color-ink));
    background: var(--color-night);
  }
  .visit-when {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .visit-name {
    margin-top: 0.15rem;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .visit-kind {
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }
  .visit-body {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .visit-ask {
    margin-top: auto;
    padding-top: 1rem;
    align-self: start;
  }
  .visit-ask-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .visit-ask-text {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
</style>
